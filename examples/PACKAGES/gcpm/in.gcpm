# Comparison of LAMMPS pair gcpm against the GCPM Fortran code
#
# Workflow:
#   1) build the compare-instrumented Fortran (adds dump_compare.f):
#        gfortran -O2 -fno-automatic -ffixed-line-length-132 -w \
#          main.f init.f force.f Pos_alc.f pre_corrc_average.f \
#          diel_cerf_hbond.f dump_compare.f -o md_water_cmp
#   2) run it (needs param, pwat1.dat, pwatin) -> writes frame.dat + eforce.dat
#        ./md_water_cmp
#   3) convert the frame to a LAMMPS data file:
#        python3 pwatin_to_lammps.py frame.dat data.gcpm
#   4) run this input and compare the printed energies to eforce.dat.
#
# GCPM parameters are taken from MD_water/param:
#   epsilon = 110 K = 0.218445 kcal/mol, sigma = 3.69 Ang, gamma(buck) = 12.75
#   M-site Gaussian width 0.610, H width 0.455, polarizability 1.444 Ang^3
#   reaction-field dielectric 78.4 (hard-coded in the Fortran), cutoff = rcut.
# The exp-6 dispersion acts between O sites (type 1) only; H/M have epsilon = 0.
#
# Compare the output between LAMMPS and Fortran at the first timestep (run 0)
#   evdwl  <->  E_disp   (exp-6, no tail)        -- matches to ~5 digits
#   pe     <->  E_total  (uconf, no tail)        -- offset by the cutoff
#                                                   convention (molecular vs
#                                                   atomic) + RF self/intra
#                                                   bookkeeping; see below.
#
# Useful isolations:
#  * dispersion only:        keep as is, compare evdwl to E_disp.
#  * pure smeared Coulomb:   pair_style gcpm 0 0.0 ${rc} ${rc}
#                            and add  'neigh_modify exclude molecule/intra all'
#                            then compare ecoul to E_coul_smear.
#
# Known differences (not bugs, see src/GCPM/gcpm_lammps_vs_fortran.md):
#  - Fortran truncates by molecule COM-COM distance; LAMMPS by atom-atom
#    distance. This shifts charge-charge (offset H/M sites) at the cutoff shell;
#    dispersion (O ~ at COM) is unaffected, hence its near-exact match.
#  - Fortran sums intermolecular Coulomb + explicit RF self terms; the LAMMPS
#    per-pair RF gets the self terms from intramolecular pairs instead.
#  - Fortran adds an analytic exp-6 tail (eset); LAMMPS uses pair_modify shift/tail.

# Two variants, selecting where the induced dipole lives:
#   COM placement (paper Eq. 3, matches the Fortran):
#     lmp -in in.gcpm  (defaults: data.gcpm5, dipoletype 4)
#   M-site placement (original 4-site decks, ~4.5% weaker dipoles):
#     lmp -in in.gcpm -v datafile data.gcpm -v dipoletype 3

variable datafile    index data.gcpm5
variable dipoletype  index 4        # 4 = COM dipole site (data.gcpm5); 3 = M site (data.gcpm)
variable equil_steps index 1000
variable relax_steps index 1000
variable r           index 1

variable T           index 298
variable P           index 1.0         # 1 atm = 0.101 MPa

variable velseed     index 817324
variable seed        index 576211

# cutoff must equal the Fortran rcut printed at startup (e.g. 11.220684 Ang)
variable rc        index 11.220684

units real
atom_style hybrid full dipole sphere
read_data ${datafile}

replicate $r $r $r

# --- full GCPM (polar + reaction field), matches the Fortran method ---
pair_style gcpm 1 78.4 ${rc} ${rc}
pair_coeff 1 1 0.218445 3.69 12.75 0.0   0.000
pair_coeff 2 2 0.0      1.0  12.75 0.0   0.455  # No LJ interactions for H atoms
if "${dipoletype} == 4" then &
  "pair_coeff 3 3 0.0      1.0  12.75 0.0   0.610" &
  "pair_coeff 4 4 0.0      1.0  12.75 1.444 0.610" &
else &
  "pair_coeff 3 3 0.0      1.0  12.75 1.444 0.610"

neigh_modify exclude molecule/intra all

thermo_style custom step pe evdwl ecoul

# initialize atom velocities
velocity all create $T ${velseed} mom yes rot yes dist gaussian

timestep 0.5

# Nose-Hoover chains: canonical sampling, the right choice for the RDF below.
# The reference log file for this deck was generated with this line.
fix 1 all rigid/nvt/small molecule temp $T $T 100.0

# Evans Gaussian isokinetic, the thermostat the Fortran uses: holds the total
# (translational + rotational) kinetic energy exactly and adds no drag, so it
# leaves transport properties alone.  Use this, not langevin, whenever the run
# has to hold a temperature without disturbing the dynamics.
#fix 1 all rigid/nvk/small molecule temp $T

# Langevin: fine for equilibrating, but its friction (gamma = 1/Tdamp = 10/ps
# at Tdamp = 100 fs) suppresses the self-diffusion coefficient by 15-25% near
# ambient.  Never use it for a production run that measures dynamics.
#fix 1 all rigid/small molecule langevin $T $T 100.0 ${seed}

#fix 1 all rigid/npt/small molecule temp $T $T 100.0 iso $P $P 50.0

# data.gcpm5 has 5 sites per molecule (COM dipole site), data.gcpm has 4
variable sites         equal (${dipoletype}==4)*5+(${dipoletype}==3)*4
variable num_mols      equal atoms/${sites}
variable water_density equal v_num_mols/vol   # molecules per Angstrom^3, expected around 0.033 for 1 g/cm^3

thermo_style custom step temp pe evdwl ecoul etotal v_water_density press
thermo 100

# compute RDF of pairs: 1-1 (O-O), 1-2 and 2-1 (O-H and H-O), and 2-2 (H-H)
compute myRDF all rdf 100 1 1 1 2 2 1 2 2

# write to file every 1000 steps, averaging over 10 samples at 100-step intervals
fix 2 all ave/time 100 10 1000 c_myRDF[*] file rdf.txt mode vector

dump 1 all custom 1000 dump.txt id mol type q x y z mux muy muz
dump_modify 1 sort id

run ${equil_steps}

# optional: a production leg for dynamic properties, replacing the Nose-Hoover
# thermostat with the isokinetic one (or with NVE, which gives the same
# transport but lets the temperature wander).  For a self-diffusion measurement
# with the MSD computed in LAMMPS, use in.gcpm.msd instead.

#unfix 1
#fix 1 all rigid/nvk/small molecule temp $T
#fix 1 all rigid/nve/small molecule

#run ${relax_steps}




