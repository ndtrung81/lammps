#fix 1 all rigid/small molecule langevin $T $T 100.0 ${seed}
#fix 1 all rigid/npt/small molecule temp $T $T 100.0 iso $P $P 50.0

variable num_mols      equal atoms/4
variable water_density equal v_num_mols/vol   # molecules per Angstrom^3, expected around 0.033 for 1 g/cm^3

thermo_style custom step temp pe evdwl ecoul etotal v_water_density press
thermo 100

# compute RDF of pairs: 1-1 (O-O), 1-2 and 2-1 (O-H and H-O), and 2-2 (H-H)
compute myRDF all rdf 100 1 1 1 2 2 1 2 2

# write to file every 1000 steps, averaging over 10 samples at 100-step intervals
fix 2 all ave/time 100 10 1000 c_myRDF[*] file rdf.txt mode vector

dump 1 all custom 1000 dump.txt id mol type q x y z mux muy muz
dump_modify 1 sort id

run ${equil_steps}
run 1000
