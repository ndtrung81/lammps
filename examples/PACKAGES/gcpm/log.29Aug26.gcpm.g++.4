# The Fortran masses are mo = 2.6564834e-23 g and mh = 1.6603021e-24 g, that is
# 15.997719 and 0.9998574 amu (molecular mass 17.99743 amu), slightly lighter
# than the 15.9994/1.008 stored in the data file.  fix rigid/small takes the
# per-atom masses from column 12 of the data file, so override them here: this
# matches the Fortran body mass and inertia and puts the LAMMPS body center of
# mass exactly on the type-4 dipole site of data.gcpm5.  Drop these two lines
# to use the standard isotope-averaged masses instead.
set type 1 mass 15.997719
Setting atom values ...
  500 settings made for mass
set type 2 mass 0.9998574
Setting atom values ...
  1000 settings made for mass

# --- full GCPM (polar + reaction field), matches the Fortran method ---
# polar/tol mirrors tol_dipole = 1e-8 (1e-4 per dipole component in the reduced
# units of the Fortran, i.e. 1.82e-5 e*Ang).  The Fortran stops after maxiter =
# 10 iterations whether or not that is met; here the cap is left at the LAMMPS
# default of 50 and the tolerance is reached in 10-12 iterations.
pair_style gcpm 1 78.4 ${rc} ${rc} polar/tol 1.8e-5 polar/maxiter 50
pair_style gcpm 1 78.4 11.220684 ${rc} polar/tol 1.8e-5 polar/maxiter 50
pair_style gcpm 1 78.4 11.220684 11.220684 polar/tol 1.8e-5 polar/maxiter 50
pair_coeff 1 1 0.218445 3.69 12.75 0.0   0.000
pair_coeff 2 2 0.0      1.0  12.75 0.0   0.455  # No LJ interactions for H atoms
if "${dipoletype} == 4" then   "pair_coeff 3 3 0.0      1.0  12.75 0.0   0.610"   "pair_coeff 4 4 0.0      1.0  12.75 1.444 0.610" else   "pair_coeff 3 3 0.0      1.0  12.75 1.444 0.610"
pair_coeff 3 3 0.0      1.0  12.75 0.0   0.610
pair_coeff 4 4 0.0      1.0  12.75 1.444 0.610

neigh_modify exclude molecule/intra all

# initialize atom velocities (the Fortran restarts from pwatin instead)
velocity all create $T ${velseed} mom yes rot yes dist gaussian
velocity all create 298.15 ${velseed} mom yes rot yes dist gaussian
velocity all create 298.15 817324 mom yes rot yes dist gaussian

# reduced time step 6e-4 of pwat1.dat, in fs
timestep 0.98213053

# Evans Gaussian isokinetic, the thermostat the Fortran uses: holds the total
# (translational + rotational) kinetic energy exactly with a single friction
# coefficient and adds no drag, so it leaves transport properties alone.  Use
# this, not langevin, whenever the run has to hold a temperature without
# disturbing the dynamics.
# Like the Fortran, it sets the kinetic energy from 3N translational plus 3N
# rotational degrees of freedom without subtracting the three center-of-mass
# ones, so the thermo Temp column reads T*3000/2997 = 298.45 K for T = 298.15.
fix 1 all rigid/nvk/small molecule temp $T
fix 1 all rigid/nvk/small molecule temp 298.15
Fix rigid/nvk/small setup ...
  create bodies CPU = 0.000 seconds
  500 rigid bodies with 2500 atoms
  0.82021669 = max distance from body owner to body atom

# Nose-Hoover chains: canonical sampling instead of isokinetic.  Fine for
# structure (the RDF below), but it is not what the Fortran does.
#fix 1 all rigid/nvt/small molecule temp $T $T 100.0

# Langevin: fine for equilibrating, but its friction (gamma = 1/Tdamp = 10/ps
# at Tdamp = 100 fs) suppresses the self-diffusion coefficient by 15-25% near
# ambient.  Never use it for a production run that measures dynamics.
#fix 1 all rigid/small molecule langevin $T $T 100.0 ${seed}

#fix 1 all rigid/npt/small molecule temp $T $T 100.0 iso $P $P 50.0

# data.gcpm5 has 5 sites per molecule (COM dipole site), data.gcpm has 4
variable sites         equal (${dipoletype}==4)*5+(${dipoletype}==3)*4
variable sites         equal (4==4)*5+(${dipoletype}==3)*4
variable sites         equal (4==4)*5+(4==3)*4
variable num_mols      equal atoms/${sites}
variable num_mols      equal atoms/5
variable water_density equal v_num_mols/vol   # molecules per Angstrom^3, expected around 0.033 for 1 g/cm^3

# quantities in the units the Fortran prints them in (prop.dat, ufile):
#   pe_mol   = configurational energy per molecule, kcal/mol (uconf, untailed)
#   p_MPa    = pressure in MPa                               (press, untailed)
#   pe_mol_t = pe_mol plus the analytic exp-6 tail eset  <-> prop.dat column 2
#   p_MPa_t  = p_MPa  plus the analytic exp-6 tail pset  <-> prop.dat column 3
#   mu_D     = mean INDUCED dipole in Debye (the point dipole on the COM/M site)
#   mu_tot_D = mean magnitude of the TOTAL molecular dipole, i.e. the vector
#              sum of the induced dipole and the permanent (charge) one
#                                                        <-> prop.dat column 4
#
# Equilibrated reference values printed by the Fortran (prop.dat, 4000-step
# blocks at 298.15 K and 0.997 g/cm3), directly comparable to prop.txt below:
#   uconf        = -10.58 kcal/mol per molecule  <-> pe_mol_t
#   P            = -26.6 MPa                     <-> p_MPa_t
#   total dipole =   2.712 D                     <-> mu_tot_D
variable pe_mol equal pe/v_num_mols
variable p_MPa  equal press*0.000101325

# exp-6 tail corrections, the eset and pset expressions of main.f rewritten in
# real units.  With rc* = rc/sigma and V* = vol/sigma^3 (the Fortran works in
# reduced units throughout):
#   E_tail per molecule = eps*(N-1)/V* * 2*pi/(1-6/g)
#       * (6/g^4 * exp(g*(1-rc*)) * ((g*rc*+1)^2+1) - 1/(3*rc*^3))
#   P_tail              = eps/sigma^3 * N*(N-1)/V*^2 * 4*pi/(1-6/g)
#       * (1/g^5 * exp(g*(1-rc*)) * ((g*rc*)^3+3*(g*rc*)^2+6*g*rc*+6)
#          - 1/(3*rc*^3))
# 6947.6955 converts kcal/mol/Ang^3 to MPa.  For 500 molecules at 0.997 g/cm3
# and rc = 11.220684 Ang these give -0.05141 kcal/mol per molecule and
# -23.83 MPa (-235 atm), the values quoted in gcpm_lammps_vs_fortran.md.
variable eps_kcal equal 0.218445
variable sigma_A  equal 3.69
variable gbuck    equal 12.75
variable rcstar   equal ${rc}/v_sigma_A
variable rcstar   equal 11.220684/v_sigma_A
variable vstar    equal vol/(v_sigma_A^3)
variable expg     equal exp(v_gbuck*(1.0-v_rcstar))
variable e_tail   equal v_eps_kcal*(v_num_mols-1)/v_vstar*2*PI/(1-6/v_gbuck)*(6/v_gbuck^4*v_expg*((v_gbuck*v_rcstar+1)^2+1)-1/(3*v_rcstar^3))
variable p_tail   equal 6947.6955*v_eps_kcal/(v_sigma_A^3)*v_num_mols*(v_num_mols-1)/(v_vstar^2)*4*PI/(1-6/v_gbuck)*(1/v_gbuck^5*v_expg*((v_gbuck*v_rcstar)^3+3*(v_gbuck*v_rcstar)^2+6*v_gbuck*v_rcstar+6)-1/(3*v_rcstar^3))

variable pe_mol_t equal v_pe_mol+v_e_tail
variable p_MPa_t  equal v_p_MPa+v_p_tail

# induced dipole only: average the point-dipole magnitude over the one dipole
# site per molecule
group dipsite type ${dipoletype}
group dipsite type 4
500 atoms in group dipsite
compute muvec all property/atom mux muy muz
variable mumag atom sqrt(c_muvec[1]^2+c_muvec[2]^2+c_muvec[3]^2)
compute mumean dipsite reduce ave v_mumag
variable mu_D equal 4.80320471*c_mumean

# total molecular dipole, as the Fortran reports it (force.f: dmol = |mxt + a3*d|).
# compute dipole/chunk sums both the per-atom charges and the per-atom point
# dipoles of each molecule, so column 4 is |permanent + induced| per molecule;
# spread it back onto the atoms to average it over the molecules.
compute molchunk  all chunk/atom molecule
compute dipmol    all dipole/chunk molchunk
compute dipspread all chunk/spread/atom molchunk c_dipmol[4]
compute mutot     dipsite reduce ave c_dipspread
variable mu_tot_D equal 4.80320471*c_mutot

thermo_style custom step temp v_pe_mol_t v_p_MPa_t v_mu_tot_D v_mu_D pe evdwl ecoul etotal press v_water_density
thermo ${nout}
thermo 200

# prop.dat equivalent: block averages of the three reported quantities over
# nblk = 4000 steps (line 7 of pwat1.dat), capped at the run length so the
# short default run still writes a block.
variable nblk equal (v_nsteps>=4000)*4000+(v_nsteps<4000)*v_nsteps
fix 4 all ave/time 1 $(v_nblk) $(v_nblk) v_pe_mol_t v_p_MPa_t v_mu_tot_D file prop.txt
fix 4 all ave/time 1 1000 $(v_nblk) v_pe_mol_t v_p_MPa_t v_mu_tot_D file prop.txt
fix 4 all ave/time 1 1000 1000 v_pe_mol_t v_p_MPa_t v_mu_tot_D file prop.txt

# RDF of the O-O, O-H and H-H site pairs, with the Fortran binning of gofr.dat:
# 334 bins of rdel = 0.01 sigma = 0.0369 Ang.  The Fortran histograms every
# intermolecular site pair (no cutoff) every KSORT = 10 steps, so extend the
# ghost cutoff to reach 12.3246 Ang and sample every 10 steps.  Intramolecular
# pairs are excluded on both sides (the Fortran loops over j != i molecules).
variable nbin equal 334
variable rrdf equal 334*0.0369
comm_modify cutoff 13.44
compute myRDF all rdf ${nbin} 1 1 1 2 2 2 cutoff ${rrdf}
compute myRDF all rdf 334 1 1 1 2 2 2 cutoff ${rrdf}
compute myRDF all rdf 334 1 1 1 2 2 2 cutoff 12.3246
fix 2 all ave/time 10 $(v_nsteps/10) ${nsteps} c_myRDF[*] file rdf.txt mode vector
fix 2 all ave/time 10 100 ${nsteps} c_myRDF[*] file rdf.txt mode vector
fix 2 all ave/time 10 100 1000 c_myRDF[*] file rdf.txt mode vector

# mean squared displacement of the molecular centers of mass, as in meansq.dat.
# The O site is only 0.066 Ang from the COM, so its MSD slope is the COM slope.
group Osites type 1
500 atoms in group Osites
compute msdcom Osites msd com yes
fix 3 all ave/time ${nout} 1 ${nout} c_msdcom[4] file msd.txt
fix 3 all ave/time 200 1 ${nout} c_msdcom[4] file msd.txt
fix 3 all ave/time 200 1 200 c_msdcom[4] file msd.txt

dump 1 all custom ${nout} dump.txt id mol type q x y z mux muy muz
dump 1 all custom 200 dump.txt id mol type q x y z mux muy muz
dump_modify 1 sort id

run ${nsteps}
run 1000
