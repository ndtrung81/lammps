# --- full GCPM (polar + Ewald/PPPM), eps_rf must be 0 for gcpm/long ---
pair_style gcpm/long 1 0.0 ${rc}
pair_style gcpm/long 1 0.0 11.220684
pair_coeff 1 1 0.218445 3.69 12.75 0.0   0.000
pair_coeff 2 2 0.0      1.0  12.75 0.0   0.455  # No LJ interactions for H atoms
pair_coeff 3 3 0.0      1.0  12.75 1.444 0.610  # No LJ interactions for M atoms

kspace_style pppm/dipole 0.0001
# pin the Ewald splitting: the automatic estimate is effectively charge-only
# while the induced-dipole seeds are near zero (g_ewald*cut_coul >= ~3.3
# keeps the real-space truncation below the grid error)
kspace_modify gewald 0.30
Updated KSpace settings:
  KSpace computation is turned:    ON
  Use MPI collective operations:   OFF
  Use MPI non-blocking operations: OFF
  Gewald manually set to:          0.3

thermo_style custom step pe evdwl ecoul

# initialize atom velocities
velocity all create $T ${velseed} mom yes rot yes dist gaussian
velocity all create 298 ${velseed} mom yes rot yes dist gaussian
velocity all create 298 817324 mom yes rot yes dist gaussian

timestep 0.5

fix 1 all rigid/nvt/small molecule temp $T $T 100.0
fix 1 all rigid/nvt/small molecule temp 298 $T 100.0
fix 1 all rigid/nvt/small molecule temp 298 298 100.0
