# Water box with explicit TIP4P water model for use with fix rigid and  hybrid full and dipole atom styles

variable steps index 1000
variable r     index 4

units real
atom_style hybrid full dipole sphere

read_data data.tip4p

replicate $r $r $r

mass 1 15.9994   # O
mass 2 1.008     # H
mass 3 1.0e-100  # site M

# pair style parameters:          coul_smooth alpha  enable_polar cutlj [cutcoul]
pair_style buck6/coul/gauss/long 0.95         0.608  1            12.0

# coeffs       epsilon sigma  gamma  alpha_pol sigmaM
pair_coeff 1 1 0.1550  3.1536 12.75  0.0       0.000
pair_coeff 2 2 0.0     1.0    12.75  0.0       0.455
pair_coeff 3 3 0.0     1.0    12.75  1.444     0.610

kspace_style pppm 0.0001

neigh_modify exclude molecule/intra all

velocity all create 300.0 187421 mom yes rot yes

timestep 0.5

fix 1 all rigid/small molecule langevin 300.0 300.0 100.0 2345634
#fix 1 all rigid/nvt/small molecule temp 300.0 300.0 100.0

#thermo_style custom step temp pe etotal ecoul etotal density press
thermo_style custom step ke temp pe etotal ecoul etotal press
thermo 100

dump 1 all custom 100 dump.txt id mol type q x y z mux muy muz
dump_modify 1 sort id

run ${steps}

write_dump all custom final.dump id mol type q x y z mux muy muz modify sort id
