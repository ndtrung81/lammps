# Water box with explicit TIP4P water model for use with fix rigid and  hybrid full and dipole atom styles

variable steps     index 100
variable r         index 1               # 4 for data.tip4p
variable datafile  index data.water_box  # data.tip4p

units real
atom_style hybrid full dipole sphere

read_data ${datafile}

replicate $r $r $r

variable num_mols      equal atoms/4
variable water_density equal v_num_mols/vol   # molecules per Angstrom^3, expected around 0.033

mass 1 15.9994   # O
mass 2 1.008     # H
mass 3 1.0e-100  # site M

# pair style parameters:  enable_polar eps_rf cut_buck [cutcoul]
pair_style gcpm           1            78.0   12.0

# coeffs       epsilon sigma  gamma  alpha_pol sigmaM
pair_coeff 1 1 0.1550  3.1536 12.75  0.0       0.000
pair_coeff 2 2 0.0     1.0    12.75  0.0       0.455
pair_coeff 3 3 0.0     1.0    12.75  1.444     0.610

# the GCPM model excludes the intramolecular Coulombic interaction
neigh_modify exclude molecule/intra all

velocity all create 298.0 187421 mom yes rot yes

timestep 0.5

# Tdamp = 100 fs (gamma = 10/ps).  A much stiffer coupling injects large
# random forces every step, which shows up as huge instantaneous pressures.
fix 1 all rigid/small molecule langevin 298.0 298.0 100.0 234563

thermo_style custom step temp pe evdwl ecoul etotal v_water_density press
thermo 10

dump 1 all custom 100 dump.txt id mol type q x y z mux muy muz
dump_modify 1 sort id

run ${steps}

write_dump all custom final.dump id mol type q x y z mux muy muz modify sort id
#write_data final.data nocoeff
