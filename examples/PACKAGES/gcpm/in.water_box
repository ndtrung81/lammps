# Water box with explicit TIP4P water model, read from tip4p.mol

variable t index 1000
variable r index 1

units real

atom_style full
atom_modify map array
region box block 0 10 0 10 0 10
create_box 3 box

mass 1 15.9994
mass 2 1.008
mass 3 1.0e-100

molecule water tip4p.mol
create_atoms 0 random 33 34564 NULL mol water 25367 overlap 1.33

replicate $r $r $r

pair_style lj/cut/coul/gauss/long 0.9 0.608 12.0
pair_coeff 1 1 0.1550 3.1536 1.444
pair_coeff 2 2 0.0    1.0    0.0
pair_coeff 3 3 0.0    1.0    0.0

kspace_style pppm 0.0001

neigh_modify exclude molecule/intra all

velocity all create 300.0 187421 mom yes rot yes

timestep 0.5

#fix 1 all rigid/small molecule langevin 300.0 300.0 100.0 2345634

fix 1 all rigid/nvt/small molecule temp 300.0 300.0 100.0

compute cc1 all chunk/atom molecule
compute dipole all dipole/chunk cc1

thermo_style custom step temp press ecoul etotal density pe ke
thermo 1000

dump 1 all custom 100  dump.txt id mol type q x y z
dump_modify 1 sort id

run $t
